# Server
NODE_ENV=development
PORT=4000
APP_NAME=OPERA Config Manager

# JWT
JWT_SECRET=change-this-secret-before-running
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Oracle Autonomous DB with wallet
DB_USER=OPERA_CFG_APP
DB_PASSWORD=change-this-password
DB_CONNECT_STRING=your_high_service_name
DB_WALLET_DIR=../wallet
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1

# CORS
CORS_ORIGIN=http://localhost:4000
